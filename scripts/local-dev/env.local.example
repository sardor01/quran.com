NEXT_PUBLIC_VERCEL_ENV=development
NEXT_PUBLIC_VERCEL_URL=localhost:3100

# Local stand-in gateway (scripts/local-dev/qurancdn-gateway.js) -> public https://api.qurancdn.com
API_GATEWAY_URL=http://localhost:4000

# Browser requests to /api/proxy are only accepted from these hostnames
ALLOWED_ORIGINS=localhost,127.0.0.1

# Local-only placeholder values (from .env.example)
SIGNATURE_TOKEN=1234
PROXY_SIGNATURE_TOKEN=123456
INTERNAL_CLIENT_ID=QDC_WEB

NEXT_PUBLIC_SERVER_SENTRY_ENABLED=false
NEXT_PUBLIC_CLIENT_SENTRY_ENABLED=false
NEXT_PUBLIC_SSO_ENABLED=false
NEXT_PUBLIC_AUTH_PROFILE_TIMEOUT_MS=4000
NEXT_PUBLIC_QURAN_REFLECT_URL=https://quranreflect.com
NEXT_PUBLIC_EMBED_URL=http://localhost:3100/embed/v1
